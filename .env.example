# Geek-Os environment example
# Copy this file to .env and fill in your own values.
# Never commit real credentials.

# Server
PORT=8080
WIDGET_BASE_URL=http://localhost:8080
NODE_ENV=development

# Notion internal integration token used by maintainer/dev utilities.
# For user workspaces, prefer OAuth below.
NOTION_TOKEN=ntn_your_notion_integration_token_here

# Notion OAuth app credentials
NOTION_CLIENT_ID=your_notion_oauth_client_id_here
NOTION_CLIENT_SECRET=your_notion_oauth_client_secret_here

# Optional default Notion database IDs
NOTION_DATABASE_ID=your_anime_database_id_here
NOTION_MANGA_DATABASE_ID=your_manga_database_id_here
NOTION_GAMES_DATABASE_ID=your_games_database_id_here
NOTION_COMICS_DATABASE_ID=your_comics_database_id_here
NOTION_MOVIE_DATABASE_ID=your_movie_database_id_here
NOTION_TV_DATABASE_ID=your_tv_database_id_here
NOTION_BOOK_DATABASE_ID=your_book_database_id_here

# Optional default template IDs
NOTION_ANIME_TEMPLATE_ID=your_anime_template_id_here
NOTION_MANGA_TEMPLATE_ID=your_manga_template_id_here
NOTION_GAMES_TEMPLATE_ID=your_games_template_id_here
NOTION_COMICS_TEMPLATE_ID=your_comics_template_id_here
NOTION_MOVIE_TEMPLATE_ID=your_movie_template_id_here
NOTION_TV_TEMPLATE_ID=your_tv_template_id_here
NOTION_BOOK_TEMPLATE_ID=your_book_template_id_here

# Optional MyAnimeList sync config
MAL_USERNAME=your_myanimelist_username_here
SYNC_STATUSES=watching,completed,plan_to_watch

# Optional Vercel KV token store
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional Vercel Blob cover uploads
BLOB_READ_WRITE_TOKEN=

# Optional Edge Config feature flags
EDGE_CONFIG=

# Optional Supabase token store
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
