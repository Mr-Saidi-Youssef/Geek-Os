# Notion Integration Credentials
# Get your token at https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_integration_token_here

# The ID of your Anime Database. 
# Found in the URL of your database: https://www.notion.so/DATABASE_ID?v=...
NOTION_DATABASE_ID=your_database_id_here

# Your MyAnimeList Username (no spaces)
MAL_USERNAME=your_myanimelist_username_here

# Optional: Comma-separated watch statuses to sync.
# Allowed: watching, completed, plan_to_watch, on_hold, dropped
# Leave blank to sync your entire list.
SYNC_STATUSES=watching,completed,plan_to_watch

# Notion Movies Database ID (Top 1000 Movies)
NOTION_MOVIE_DATABASE_ID=your_movie_database_id_here

# Notion TV Series Database ID (Top 1000 TV Shows)
NOTION_TV_DATABASE_ID=your_tv_database_id_here

# TMDb (The Movie Database) API Key (v3 32-character string)
# Register a free account at https://www.themoviedb.org/ and go to Settings -> API
TMDB_API_KEY=your_tmdb_api_key_here

